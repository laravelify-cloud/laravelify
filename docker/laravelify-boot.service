[Unit]
Description=Prepare Laravelify in this Ubuntu container
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/laravelify/artisan

[Service]
Type=oneshot
ExecStart=/usr/local/bin/laravelify-bootstrap.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
